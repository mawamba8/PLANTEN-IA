generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  FARMER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  phone     String?
  role      RoleName  @default(FARMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnostics Diagnostic[]
}

model AgriculturalCenter {
  id          String   @id @default(cuid())
  name        String
  city        String
  latitude    Float
  longitude   Float
  phone       String?
  email       String?
  description String?
  createdAt   DateTime @default(now())
}

model Diagnostic {
  id              String   @id @default(cuid())
  userId          String
  imageUrl        String?
  diseaseName     String
  confidence      Float
  symptoms        String?
  recommendations String?
  prevention      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
